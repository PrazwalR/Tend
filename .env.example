# Copy to `.env` and fill in your own values. `.env` is gitignored — never commit real secrets.

# --- RPC (per chain; WS endpoint required for eth_subscribe) ---
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WS_ETHEREUM=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WS_BASE=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- gRPC (`lpa serve`) ---
LPA_GRPC_PORT=50051
LPA_GRPC_HOST=127.0.0.1
# Bearer token required on all serve RPCs when set; unauthenticated + warned if empty.
LPA_API_TOKEN=

# --- Execution (`lpa watch --execute` / `lpa rebalance`) ---
# Testnet only for a raw key. Use a keystore / external signer in production.
REBALANCER_PRIVATE_KEY=
AUTOPILOT_HOOK_ADDRESS=
# Optional private/Flashbots submission endpoint for the rebalance tx.
FLASHBOTS_RPC=
# Seed only. The executor's USD spend cap requires a FRESH on-chain Chainlink
# read and refuses to send a transaction without one, so this value never
# authorises spending by itself — it only pre-fills the strategy's estimate
# until the first read lands.
ETH_PRICE_USD=3000.0
# Still operator assumptions — no pool-volume or token oracle yet.
LPA_VOLUME_USD_PER_BLOCK=50000
# USD price of the pool's token1. Needed to value a position, which in turn
# enables the IL / slippage / MEV terms of the EV gate. 0 or unset leaves the
# gate fee-and-gas only rather than guessing.
LPA_TOKEN1_USD=0

# --- Executor / strategy tuning ---
DEFAULT_MAX_GAS_USD=50.0
LPA_MIN_TICKS=8
# EV gate friction, in bps of position value.
LPA_SLIPPAGE_BPS=30
LPA_MEV_BPS=10
LPA_AUTO_INTERVAL_SECS=300
LPA_TX_TIMEOUT_SECS=120
LPA_WS_HEARTBEAT_SECS=30
# Seconds between sweeps that retry stuck positions and place idle balances.
LPA_SWEEP_SECS=30
# Idle share of a position (bps) worth a same-range rebalance to place.
LPA_IDLE_REDEPLOY_BPS=100
# Rolling one-hour cap on what the daemon spends, across rebalances and pokes.
LPA_MAX_SPEND_USD_PER_HOUR=100

# --- Hook deploy (`forge script DeployAutopilotHook`) ---
POOL_MANAGER=0x498581fF718922c3f8e6A244956aF099B2652b2b
REBALANCER_ADDRESS=
REBALANCE_COOLDOWN_SECS=3600
# Hook owner; defaults to the deployer. Use a multisig in production.
HOOK_OWNER=
# The pool this deployment accepts (full pool key; the hook is filled in). The
# allowlist is enforced at deploy, so with these unset deposits stay closed
# until the owner calls setAllowedPool.
ALLOWED_POOL_TOKEN0=
ALLOWED_POOL_TOKEN1=
ALLOWED_POOL_FEE=3000
ALLOWED_POOL_TICK_SPACING=60
# Chainlink L2 sequencer uptime feed (Base); leave unset on L1.
SEQUENCER_UPTIME_FEED=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Logging ---
RUST_LOG=lpa=info,tonic=warn
